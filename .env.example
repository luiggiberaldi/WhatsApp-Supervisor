# =============================================================================
# WhatsApp Supervisor — Configuración de Entorno
# =============================================================================
# Copiar como .env y reemplazar con valores reales.
# ⚠️  NO dejes placeholders activos (valores que empiecen con "your-")
#     porque el backend los interpreta como configuración válida y las queries
#     a Supabase fallarán con "Invalid API key".
# =============================================================================

# ── Supabase ─────────────────────────────────────────────────────────────────
# Obligatorias para modo persistente. Si se omiten, el backend opera en
# "modo local" (Zustand demo data, sin persistencia).
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Opcional (server-side). Si está presente, el backend la usa para bypass de RLS
# en webhooks. Si es un placeholder o está comentada, se usa VITE_SUPABASE_ANON_KEY.
# ⚠️  NO usar un valor "your-..." — el backend lo ignora, pero mejor no tenerla puesta.
# SUPABASE_SERVICE_ROLE_KEY=""

# ── Evolution API (solo server-side) ────────────────────────────────────────
# Opcionales para desarrollo. Sin ellas el backend opera en modo simulado
# (los mensajes salientes se registran con estado "failed" en lugar de enviarse).
EVOLUTION_API_URL="http://your-evolution-instance.com"
EVOLUTION_API_KEY="your-global-api-key"
EVOLUTION_INSTANCE_NAME="main"

# ── Seguridad Webhook ───────────────────────────────────────────────────────
# Opcional en desarrollo. Si está presente, el endpoint /api/webhooks/evolution
# exige el header "x-webhook-secret" con este valor exacto.
WEBHOOK_SECRET="my_secure_webhook_secret"
